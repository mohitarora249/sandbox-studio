{
  "name": "sandbox-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first control plane for creating and managing isolated Docker sandbox environments.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "build:runtimes": "docker build -f Dockerfile.sandbox --target node-runtime -t sandbox-studio/node-runtime:22 . && docker build -f Dockerfile.sandbox --target python-runtime -t sandbox-studio/python-runtime:3.12 ."
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dockerode": "4.0.9",
    "jose": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76",
    "@prisma/adapter-pg": "7.10.0",
    "dotenv": "17.2.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.38",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "prisma": "7.10.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "@types/pg": "8.15.5"
  },
  "type": "module"
}
