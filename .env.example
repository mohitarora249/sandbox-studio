# PostgreSQL connection used by Prisma. The Docker Compose service uses the host name "db".
DATABASE_URL="postgresql://sandbox:sandbox_dev_password@localhost:5434/sandbox_studio?schema=public"

# Generate a long random value before exposing the app to anything beyond your own machine.
# Example: openssl rand -base64 48
AUTH_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-running"
# Set true behind HTTPS; false is only for the default localhost HTTP Compose setup.
SESSION_COOKIE_SECURE="false"

# The app connects to the Docker Engine on the server. Do not expose the daemon over unauthenticated TCP.
DOCKER_SOCKET="/var/run/docker.sock"
# Optional on Linux: set to the numeric group ID that owns /var/run/docker.sock (stat -c '%g' /var/run/docker.sock).
DOCKER_GID="0"

# Any use of a sandbox (create, start, stop, view, logs, command) resets its idle timer.
# Idle running sandboxes are stopped after SANDBOX_IDLE_STOP_MS, then destroyed (container and
# workspace volume) after SANDBOX_IDLE_DESTROY_MS. Both are measured from the last activity.
# Failed sandboxes (e.g. OOM-killed) are destroyed on the same SANDBOX_IDLE_DESTROY_MS schedule.
SANDBOX_IDLE_STOP_MS="300000"
SANDBOX_IDLE_DESTROY_MS="600000"
# Sandboxes stuck in PROVISIONING or DELETING this long (e.g. after a server crash) are cleaned up.
# It is also the grace period before Docker resources with no matching sandbox record are removed.
SANDBOX_STUCK_MS="600000"
