# PostgreSQL connection used by Prisma. The Docker Compose service uses the host name "db".
DATABASE_URL="postgresql://sandbox:sandbox_dev_password@localhost:5434/sandbox_studio?schema=public"

# Generate a long random value before exposing the app to anything beyond your own machine.
# Example: openssl rand -base64 48
AUTH_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-running"
# Set true behind HTTPS; false is only for the default localhost HTTP Compose setup.
SESSION_COOKIE_SECURE="false"
# Number of reverse proxies in front of the app that append to X-Forwarded-For. Leave 0 unless a
# proxy you control sets that header; otherwise clients could spoof it to dodge the login throttle.
TRUSTED_PROXY_COUNT="0"

# The app connects to the Docker Engine on the server. Do not expose the daemon over unauthenticated TCP.
DOCKER_SOCKET="/var/run/docker.sock"
# Optional on Linux: set to the numeric group ID that owns /var/run/docker.sock (stat -c '%g' /var/run/docker.sock).
DOCKER_GID="0"

# Using a sandbox (create, start, stop, command, keep-alive) resets its idle timer.
# Idle running sandboxes are stopped after SANDBOX_IDLE_STOP_MS, then destroyed (container and
# workspace volume) after SANDBOX_IDLE_DESTROY_MS. Both are measured from the last activity, or from
# the end of a keep-alive lease if that is later. Activity is a command, a start/stop, or a running
# container using at least SANDBOX_ACTIVE_CPU_PERCENT of one core or SANDBOX_ACTIVE_NETWORK_BYTES_PER_SECOND
# of network traffic between two sweeps. Viewing a sandbox or its logs does not count.
# Failed sandboxes (e.g. OOM-killed) are destroyed on the same SANDBOX_IDLE_DESTROY_MS schedule.
SANDBOX_IDLE_STOP_MS="300000"
SANDBOX_IDLE_DESTROY_MS="600000"
SANDBOX_ACTIVE_CPU_PERCENT="5"
SANDBOX_ACTIVE_NETWORK_BYTES_PER_SECOND="1024"
# Sandboxes stuck in PROVISIONING or DELETING this long (e.g. after a server crash) are cleaned up.
# It is also the grace period before Docker resources with no matching sandbox record are removed.
SANDBOX_STUCK_MS="600000"

# Each sandbox's /workspace may hold at most SANDBOX_DISK_QUOTA_MB. Every sweep, a running sandbox over
# the quota is stopped (its files are kept), and no single file may grow past the quota. That can
# overshoot by whatever is written in one sweep. Set SANDBOX_DISK_QUOTA_HARD to "true" only if
# Docker's data root is on XFS mounted with pquota: Docker then enforces the limit on the volume, and
# creating sandboxes fails on hosts without quota support (including Docker Desktop).
SANDBOX_DISK_QUOTA_MB="2048"
SANDBOX_DISK_QUOTA_HARD="false"
